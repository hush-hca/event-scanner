# Copy to .env for Docker Compose. Do not commit real webhook URLs or secrets.
POSTGRES_DB=eventradar
POSTGRES_USER=eventradar
POSTGRES_PASSWORD=change-me
EVENTRADAR_ENVIRONMENT=development
EVENTRADAR_DATABASE_URL=postgresql+psycopg://eventradar:change-me@postgres:5432/eventradar
EVENTRADAR_REDIS_URL=redis://redis:6379/0
# EVENTRADAR_DEVELOPMENT_WEBHOOK_URL=http://host.docker.internal:9000/webhook
